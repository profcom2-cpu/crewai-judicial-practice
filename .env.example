# Qwen / DashScope (OpenAI-совместимый API).
# Можно скопировать те же значения, что DOC_ANALYZER_QWEN_* из JuristStudio.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Совместимость с ключами JuristStudio (читаются, если QWEN_API_KEY пуст)
DOC_ANALYZER_QWEN_API_KEY=
DOC_ANALYZER_QWEN_BASE_URL=
DOC_ANALYZER_QWEN_MODEL=

# Режим LLM: cloud | ollama  (можно ещё --llm-mode в CLI)
LLM_MODE=cloud

# Локальный Ollama (python scripts/set_llm_mode.py ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_API_KEY=ollama
OLLAMA_EXE=D:\Ollama\ollama.exe

# Не слать телеметрию CrewAI при пилотном прогоне
CREWAI_TRACING_ENABLED=false
